#!/usr/bin/env bash
# Run pugrec from this checkout. Recording uses the system Python (GObject,
# evdev, nothing to install; macOS: python3 on PATH + macos/pugrec-capture); render needs numpy + OpenCV from ./.venv.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
py=/usr/bin/python3
# macOS: the system python3 is too old (tomllib needs 3.11): the first new enough one, Homebrew's
# first. `setup` installs one when there's none.
if [[ "$(uname)" == Darwin ]]; then
    py=""
    for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 "$(command -v python3 || true)"; do
        if [[ -x "$c" ]] && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
            py="$c"
            break
        fi
    done
    if [[ -z "$py" && "${1:-}" == setup ]] && command -v brew >/dev/null; then
        echo "setup: installing Python 3 (brew install python)" >&2
        brew install python && py="$(brew --prefix)/bin/python3"
    fi
    if [[ -z "$py" ]]; then
        command -v brew >/dev/null || { echo "pugrec: needs Homebrew (https://brew.sh), then 'bin/pugrec setup'" >&2; exit 1; }
        echo "pugrec: needs Python 3.11+: run 'bin/pugrec setup' (or brew install python)" >&2
        exit 1
    fi
fi
if [[ "${1:-}" =~ ^(render|faces|audio|check|build|preview|proxy|draft|themes)$ ]]; then
    py="$here/.venv/bin/python"
    [[ -x "$py" ]] || { echo "pugrec: run 'pugrec setup' first (makes .venv)" >&2; exit 1; }
fi
# No cd: relative paths (a session, an edit.yaml) are the caller's. The package comes from here.
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
exec "$py" -m pugrec "$@"
